diff --git a/SideStore/Intents/CartoucheAppsRequest.swift b/SideStore/Intents/CartoucheAppsRequest.swift
new file mode 100644
index 0000000..020bef2
--- /dev/null
+++ b/SideStore/Intents/CartoucheAppsRequest.swift
@@ -0,0 +1,100 @@
+//
+//  CartoucheAppsRequest.swift
+//  SideStore
+//
+//  Cartouche: what the launcher asks of the built-in SideStore for the apps
+//  Cartouche installs on this iPhone (decision 142), and the list of those
+//  apps, both in the app group the two share. Cartouche writes the request
+//  before it runs an intent (CartoucheInstallAppIntent,
+//  CartoucheRefreshAppsIntent, CartoucheRemoveAppIntent); the intent takes
+//  it and keeps the list, which InstalledApp.fetchCartoucheApps reads to
+//  renew those apps with Cartouche (patch 0017).
+//
+
+import Foundation
+
+enum CartoucheAppsRequest
+{
+    static let requestKey = "CartoucheAppsRequest"
+    static let installedKey = "CartoucheInstalledApps"
+
+    static var defaults: UserDefaults?
+    {
+        guard let appGroup = Bundle.main.altstoreAppGroup else { return nil }
+        return UserDefaults(suiteName: appGroup)
+    }
+
+    /// The request the launcher left, taken: the next intent finds none.
+    static func take() -> [String: Any]?
+    {
+        guard let defaults, let request = defaults.dictionary(forKey: self.requestKey) else { return nil }
+        defaults.removeObject(forKey: self.requestKey)
+        return request
+    }
+
+    /// The apps Cartouche installed, as the launcher lists them: each one's
+    /// bundle identifier, the identifier SideStore signed it under, and its
+    /// name.
+    static var installed: [[String: String]]
+    {
+        get { self.defaults?.array(forKey: self.installedKey) as? [[String: String]] ?? [] }
+        set { self.defaults?.set(newValue, forKey: self.installedKey) }
+    }
+
+    static func isInstalled(_ bundleIdentifier: String) -> Bool
+    {
+        self.installed.contains { $0["bundleIdentifier"] == bundleIdentifier }
+    }
+
+    static func remember(bundleIdentifier: String, resignedBundleIdentifier: String, name: String)
+    {
+        var listed = self.installed.filter { $0["bundleIdentifier"] != bundleIdentifier }
+        listed.append(["bundleIdentifier": bundleIdentifier, "resignedBundleIdentifier": resignedBundleIdentifier, "name": name])
+        self.installed = listed
+    }
+
+    static func forget(bundleIdentifier: String)
+    {
+        self.installed = self.installed.filter { $0["bundleIdentifier"] != bundleIdentifier }
+    }
+}
+
+/// What refuses an action in Cartouche's own words, before SideStore starts
+/// it. CartoucheOutcome tells them apart by their kind, as it does the
+/// sign-in's (CartoucheSignInError).
+enum CartoucheAppsError: LocalizedError
+{
+    /// The launcher left no request, or not the one this intent takes.
+    case noRequest
+    /// The app is in this database, installed by another SideStore or
+    /// AltStore of the same Apple ID, which renews it: not Cartouche's to
+    /// take over.
+    case anotherStoresApp(String)
+    /// A free Apple ID signs that many apps at once on this iPhone, and they
+    /// are all taken.
+    case appLimit(Int)
+    /// The app is not on Cartouche's list: not its to renew or remove.
+    case notListed(String)
+
+    var kind: String
+    {
+        switch self
+        {
+        case .noRequest: return "noRequest"
+        case .anotherStoresApp: return "anotherStoresApp"
+        case .appLimit: return "appLimit"
+        case .notListed: return "notListed"
+        }
+    }
+
+    var errorDescription: String?
+    {
+        switch self
+        {
+        case .noRequest: return "Cartouche left no request for this action."
+        case .anotherStoresApp(let name): return "\(name) was installed by another SideStore or AltStore, which renews it."
+        case .appLimit(let limit): return "A free Apple ID signs \(limit) apps at once on this iPhone, and they are all taken."
+        case .notListed(let name): return "\(name) is not an app Cartouche installed."
+        }
+    }
+}
diff --git a/SideStore/Intents/CartoucheInstallAppIntent.swift b/SideStore/Intents/CartoucheInstallAppIntent.swift
new file mode 100644
index 0000000..9ee4647
--- /dev/null
+++ b/SideStore/Intents/CartoucheInstallAppIntent.swift
@@ -0,0 +1,111 @@
+//
+//  CartoucheInstallAppIntent.swift
+//  SideStore
+//
+//  Cartouche: installs an IPA as an app of its own on this iPhone, signed
+//  with the player's Apple ID, as My Apps' sideloading would. Cartouche
+//  copies the IPA into the app group and leaves its path in the request
+//  (CartoucheAppsRequest), then runs this through LiveContainer's
+//  SideStoreSupport, in LiveProcess, as it runs Refresh All Apps, so that
+//  the player never sees SideStore. Shortcuts does not list it.
+//
+//  Two refusals come before anything goes to Apple: an app this database
+//  already holds that is not on Cartouche's list, another store's, and an
+//  install that would pass the three active apps of a free Apple ID, as
+//  SideStore itself only deactivates after the App ID is spent.
+//
+
+import AppIntents
+import CoreData
+import Foundation
+
+@available(iOS 17.0, tvOS 17.0, *)
+struct CartoucheInstallAppIntent: AppIntent, ProgressReportingIntent
+{
+    static var title: LocalizedStringResource = "Install an app for Cartouche"
+    static var description = IntentDescription("Installs an IPA on this iPhone for Cartouche.")
+    static var openAppWhenRun = false
+    static var isDiscoverable: Bool { false }
+
+    init()
+    {
+        self.progress.completedUnitCount = 0
+        self.progress.totalUnitCount = 100
+    }
+
+    func perform() async throws -> some IntentResult
+    {
+        let outcome = CartoucheOutcome(action: .install)
+        guard let request = CartoucheAppsRequest.take(), let path = request["ipa"] as? String else {
+            let error = CartoucheAppsError.noRequest
+            outcome.save(error: error, stage: "request", progress: self.progress)
+            throw IntentError(error)
+        }
+        let ipa = URL(fileURLWithPath: path)
+        // The copy is Cartouche's for this install alone.
+        defer { try? FileManager.default.removeItem(at: ipa) }
+        do
+        {
+            try await DatabaseManager.shared.start()
+            self.progress.completedUnitCount = 5
+
+            let (bundleIdentifier, name) = try AppManager.readAppMetadata(from: ipa, packageType: .ipa)
+            try await self.refuseWhatIsNotCartouchesToInstall(bundleIdentifier: bundleIdentifier, name: name)
+            self.progress.completedUnitCount = 10
+
+            let intentProgress = self.progress
+            let installedApp = try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<InstalledApp, Error>) in
+                DispatchQueue.main.async {
+                    let group = AppManager.shared.install(.url(ipa), presentingViewController: nil) { result in
+                        continuation.resume(with: result)
+                    }
+                    intentProgress.addChild(group.progress, withPendingUnitCount: 90)
+                }
+            }
+            let (installed, resigned, installedName) = await installedApp.managedObjectContext?.perform {
+                (installedApp.bundleIdentifier, installedApp.resignedBundleIdentifier, installedApp.name)
+            } ?? (bundleIdentifier, bundleIdentifier, name)
+            CartoucheAppsRequest.remember(bundleIdentifier: installed, resignedBundleIdentifier: resigned, name: installedName)
+
+            outcome.save(error: nil, progress: self.progress)
+            return .result()
+        }
+        catch
+        {
+            outcome.save(error: error, progress: self.progress)
+            throw IntentError(error)
+        }
+    }
+
+    /// Another store's app, or the last of a free Apple ID's three: refused
+    /// here, in Cartouche's words, rather than after Apple registered the
+    /// App ID.
+    private func refuseWhatIsNotCartouchesToInstall(bundleIdentifier: String, name: String) async throws
+    {
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            DispatchQueue.main.async {
+                let context = DatabaseManager.shared.viewContext
+                let predicate = NSPredicate(format: "%K == %@", #keyPath(InstalledApp.bundleIdentifier), bundleIdentifier)
+                if let existing = InstalledApp.first(satisfying: predicate, in: context),
+                   !CartoucheAppsRequest.isInstalled(bundleIdentifier)
+                {
+                    continuation.resume(throwing: CartoucheAppsError.anotherStoresApp(existing.name))
+                    return
+                }
+                if let limit = UserDefaults.standard.activeAppsLimit, !CartoucheAppsRequest.isInstalled(bundleIdentifier)
+                {
+                    let taken = InstalledApp.fetch(InstalledApp.activeAppsFetchRequest(), in: context)
+                        .filter { ($0.team?.type ?? .unknown) == .free }
+                        .map { $0.requiredActiveSlots }
+                        .reduce(0, +)
+                    if taken + 1 > limit
+                    {
+                        continuation.resume(throwing: CartoucheAppsError.appLimit(limit))
+                        return
+                    }
+                }
+                continuation.resume()
+            }
+        }
+    }
+}
