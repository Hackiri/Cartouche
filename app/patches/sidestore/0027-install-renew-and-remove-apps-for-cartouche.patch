diff --git a/SideStore/Intents/CartoucheRefreshAppsIntent.swift b/SideStore/Intents/CartoucheRefreshAppsIntent.swift
new file mode 100644
index 0000000..4bfa1ec
--- /dev/null
+++ b/SideStore/Intents/CartoucheRefreshAppsIntent.swift
@@ -0,0 +1,83 @@
+//
+//  CartoucheRefreshAppsIntent.swift
+//  SideStore
+//
+//  Cartouche: renews the apps Cartouche installed on this iPhone that the
+//  request names (CartoucheAppsRequest), one or several, as My Apps'
+//  Refresh would. Cartouche runs it through LiveContainer's
+//  SideStoreSupport, in LiveProcess, so that the player never sees
+//  SideStore; Renew now keeps running Refresh All Apps, which renews these
+//  apps with Cartouche (patch 0017). Shortcuts does not list it.
+//
+
+import AppIntents
+import CoreData
+import Foundation
+
+@available(iOS 17.0, tvOS 17.0, *)
+struct CartoucheRefreshAppsIntent: AppIntent, ProgressReportingIntent
+{
+    static var title: LocalizedStringResource = "Renew apps for Cartouche"
+    static var description = IntentDescription("Renews apps Cartouche installed on this iPhone.")
+    static var openAppWhenRun = false
+    static var isDiscoverable: Bool { false }
+
+    init()
+    {
+        self.progress.completedUnitCount = 0
+        self.progress.totalUnitCount = 100
+    }
+
+    func perform() async throws -> some IntentResult
+    {
+        let outcome = CartoucheOutcome(action: .apps)
+        guard let request = CartoucheAppsRequest.take(), let asked = request["apps"] as? [String] else {
+            let error = CartoucheAppsError.noRequest
+            outcome.save(error: error, stage: "request", progress: self.progress)
+            throw IntentError(error)
+        }
+        do
+        {
+            try await DatabaseManager.shared.start()
+            self.progress.completedUnitCount = 5
+
+            // Those on Cartouche's list alone: never another store's app.
+            let identifiers = asked.filter { CartoucheAppsRequest.isInstalled($0) }
+            let intentProgress = self.progress
+            let results = try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<[String: Result<InstalledApp, Error>], Error>) in
+                DispatchQueue.main.async {
+                    let context = DatabaseManager.shared.viewContext
+                    let predicate = NSPredicate(format: "%K IN %@", #keyPath(InstalledApp.bundleIdentifier), identifiers)
+                    let apps = InstalledApp.all(satisfying: predicate, in: context)
+                    guard !apps.isEmpty else {
+                        continuation.resume(throwing: CartoucheAppsError.notListed(asked.joined(separator: ", ")))
+                        return
+                    }
+                    let group = AppManager.shared.refresh(apps, presentingViewController: nil)
+                    group.completionHandler = { results in
+                        continuation.resume(returning: results)
+                    }
+                    intentProgress.addChild(group.progress, withPendingUnitCount: 95)
+                }
+            }
+
+            let failed = results.compactMap { identifier, result -> (String, Error)? in
+                if case .failure(let error) = result { return (identifier, error) }
+                return nil
+            }
+            if let first = failed.first
+            {
+                outcome.note("failed", failed.map { $0.0 }.sorted().joined(separator: ","))
+                throw first.1
+            }
+
+            outcome.save(error: nil, progress: self.progress)
+            return .result()
+        }
+        catch
+        {
+            outcome.save(error: error, progress: self.progress)
+            throw IntentError(error)
+        }
+    }
+}
diff --git a/SideStore/Intents/CartoucheRemoveAppIntent.swift b/SideStore/Intents/CartoucheRemoveAppIntent.swift
new file mode 100644
index 0000000..db27ef1
--- /dev/null
+++ b/SideStore/Intents/CartoucheRemoveAppIntent.swift
@@ -0,0 +1,102 @@
+//
+//  CartoucheRemoveAppIntent.swift
+//  SideStore
+//
+//  Cartouche: uninstalls an app Cartouche installed on this iPhone, the one
+//  the request names (CartoucheAppsRequest), as My Apps' Delete would: off
+//  the iPhone through minimuxer, then out of this database. An app the
+//  player already deleted from the home screen only leaves the database.
+//  Either way it leaves Cartouche's list. Cartouche runs it through
+//  LiveContainer's SideStoreSupport, in LiveProcess, so that the player
+//  never sees SideStore. Shortcuts does not list it.
+//
+
+import AppIntents
+import CoreData
+import Foundation
+import Minimuxer
+
+@available(iOS 17.0, tvOS 17.0, *)
+struct CartoucheRemoveAppIntent: AppIntent, ProgressReportingIntent
+{
+    static var title: LocalizedStringResource = "Uninstall an app for Cartouche"
+    static var description = IntentDescription("Uninstalls an app Cartouche installed on this iPhone.")
+    static var openAppWhenRun = false
+    static var isDiscoverable: Bool { false }
+
+    init()
+    {
+        self.progress.completedUnitCount = 0
+        self.progress.totalUnitCount = 100
+    }
+
+    func perform() async throws -> some IntentResult
+    {
+        let outcome = CartoucheOutcome(action: .remove)
+        guard let request = CartoucheAppsRequest.take(), let identifier = request["app"] as? String else {
+            let error = CartoucheAppsError.noRequest
+            outcome.save(error: error, stage: "request", progress: self.progress)
+            throw IntentError(error)
+        }
+        do
+        {
+            guard CartoucheAppsRequest.isInstalled(identifier) else { throw CartoucheAppsError.notListed(identifier) }
+            try await DatabaseManager.shared.start()
+            self.progress.completedUnitCount = 5
+
+            let installedApp = try await self.installedApp(identifier)
+            var stage: String? = nil
+            do
+            {
+                try await self.run { completion in AppManager.shared.deleteApp(installedApp, presentingViewController: nil, completionHandler: completion) }
+            }
+            catch
+            {
+                // The iPhone has no such app any more, deleted from the home
+                // screen: the record alone goes. Any other failure, of
+                // minimuxer, the VPN or the pairing file, stops here. The
+                // pipeline may wrap the error in a title (CartoucheOutcome).
+                guard case .uninstallApp(_)? = CartoucheOutcome.unwrapped(error) as? MinimuxerError else { throw error }
+                stage = "recordOnly"
+                try await self.run { completion in AppManager.shared.removeApp(installedApp, presentingViewController: nil, completionHandler: completion) }
+            }
+            CartoucheAppsRequest.forget(bundleIdentifier: identifier)
+
+            self.progress.completedUnitCount = 100
+            outcome.save(error: nil, stage: stage, progress: self.progress)
+            return .result()
+        }
+        catch
+        {
+            outcome.save(error: error, progress: self.progress)
+            throw IntentError(error)
+        }
+    }
+
+    private func installedApp(_ identifier: String) async throws -> InstalledApp
+    {
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<InstalledApp, Error>) in
+            DispatchQueue.main.async {
+                let predicate = NSPredicate(format: "%K == %@", #keyPath(InstalledApp.bundleIdentifier), identifier)
+                if let app = InstalledApp.first(satisfying: predicate, in: DatabaseManager.shared.viewContext)
+                {
+                    continuation.resume(returning: app)
+                }
+                else
+                {
+                    continuation.resume(throwing: CartoucheAppsError.notListed(identifier))
+                }
+            }
+        }
+    }
+
+    /// Runs one of AppManager's removals on the main queue, as My Apps does.
+    private func run<T>(_ action: @escaping (@escaping (Result<T, Error>) -> Void) -> Void) async throws
+    {
+        _ = try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<T, Error>) in
+            DispatchQueue.main.async {
+                action { result in continuation.resume(with: result) }
+            }
+        }
+    }
+}
