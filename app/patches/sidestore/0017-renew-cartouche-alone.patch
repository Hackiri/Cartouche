From 3318ddeb4d546311dbfb10721412032ce01d6bbb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 11:10:01 -0500
Subject: [PATCH] Renew Cartouche and the apps it installed alone

SideStore keeps its database in its app group, and Cartouche signs
with the group of every SideStore of the same Apple ID,
group.com.SideStore.SideStore.<team>: a SideStore or a
LiveContainer+SideStore of the player's shares it, and their apps are
in Cartouche's database too. Refresh All Apps renewed them with
Cartouche, and an app it could not renew failed the renewal with its
own error, "Invalid parameters", once Cartouche itself had been
renewed.

Refresh All Apps, which Cartouche's Renew now and its Shortcuts action
run, and the background refresh now renew Cartouche, the app SideStore
is built into, and the apps Cartouche itself installed on this iPhone
through SideStore (decision 137), which Cartouche lists in the app
group under CartoucheInstalledApps (CartoucheAppsRequest.swift, patch
0027). Nothing of another store's: the SideStore that installed an
app renews it, as before.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 AltStore/Core/Model/InstalledApp.swift | 59 ++++++++++++++++----------
 1 file changed, 37 insertions(+), 22 deletions(-)

diff --git a/AltStore/Core/Model/InstalledApp.swift b/AltStore/Core/Model/InstalledApp.swift
index ccb7133..3b1abd1 100644
--- a/AltStore/Core/Model/InstalledApp.swift
+++ b/AltStore/Core/Model/InstalledApp.swift
@@ -387,18 +387,41 @@ public extension InstalledApp
         return activeApps
     }
     
-    class func fetchAppsForRefreshingAll(in context: NSManagedObjectContext) -> [InstalledApp]
+    /// Cartouche: the active apps Cartouche installed on this iPhone through
+    /// the built-in SideStore, by the list Cartouche keeps in the app group
+    /// (CartoucheInstalledApps, CartoucheAppsRequest.swift), the soonest to
+    /// expire first; with DATE, those not renewed since. Never another
+    /// store's apps, which this database holds too.
+    class func fetchCartoucheApps(in context: NSManagedObjectContext, refreshedBefore date: Date? = nil) -> [InstalledApp]
     {
-        let predicate = NSPredicate(format: "(%K == YES AND %K != %@) AND (%K == nil OR %K == NO OR %K == YES)",
-                                    #keyPath(InstalledApp.isActive),
-                                    #keyPath(InstalledApp.bundleIdentifier), StoreApp.altstoreAppID,
-                                    #keyPath(InstalledApp.storeApp),
-                                    #keyPath(InstalledApp.storeApp.isPledgeRequired),
-                                    #keyPath(InstalledApp.storeApp.isPledged))
+        guard let appGroup = Bundle.main.altstoreAppGroup,
+              let listed = UserDefaults(suiteName: appGroup)?.array(forKey: "CartoucheInstalledApps") as? [[String: String]]
+        else { return [] }
+        let identifiers = listed.compactMap { $0["bundleIdentifier"] }
+        if identifiers.isEmpty { return [] }
         
-        var installedApps = InstalledApp.all(satisfying: predicate,
-                                             sortedBy: [NSSortDescriptor(keyPath: \InstalledApp.expirationDate, ascending: true)],
-                                             in: context)
+        var format = "(%K == YES) AND (%K IN %@)"
+        var arguments: [Any] = [#keyPath(InstalledApp.isActive), #keyPath(InstalledApp.bundleIdentifier), identifiers]
+        if let date
+        {
+            format += " AND (%K < %@)"
+            arguments += [#keyPath(InstalledApp.refreshedDate), date as NSDate]
+        }
+        let predicate = NSPredicate(format: format, argumentArray: arguments)
+        return InstalledApp.all(satisfying: predicate,
+                                sortedBy: [NSSortDescriptor(keyPath: \InstalledApp.expirationDate, ascending: true)],
+                                in: context)
+    }
+    
+    class func fetchAppsForRefreshingAll(in context: NSManagedObjectContext) -> [InstalledApp]
+    {
+        // Cartouche: this database is in the app group that every SideStore
+        // signed with the same Apple ID opens, so it also holds the apps of
+        // the player's own SideStore or LiveContainer+SideStore, which renews
+        // them itself. Cartouche renews the apps it installed on this iPhone
+        // itself, those on the list it keeps in the app group
+        // (fetchCartoucheApps), and Cartouche, added below.
+        var installedApps = InstalledApp.fetchCartoucheApps(in: context)
         
         if let altStoreApp = InstalledApp.fetchAltStore(in: context)
         {
@@ -427,18 +450,10 @@ public extension InstalledApp
         // Date 6 hours before now.
         let date = Date().addingTimeInterval(-1 * 6 * 60 * 60)
         
-        let predicate = NSPredicate(format: "(%K == YES) AND (%K < %@) AND (%K != %@) AND (%K == nil OR %K == NO OR %K == YES)",
-                                    #keyPath(InstalledApp.isActive),
-                                    #keyPath(InstalledApp.refreshedDate), date as NSDate,
-                                    #keyPath(InstalledApp.bundleIdentifier), StoreApp.altstoreAppID,
-                                    #keyPath(InstalledApp.storeApp),
-                                    #keyPath(InstalledApp.storeApp.isPledgeRequired),
-                                    #keyPath(InstalledApp.storeApp.isPledged)
-        )
-        
-        var installedApps = InstalledApp.all(satisfying: predicate,
-                                             sortedBy: [NSSortDescriptor(keyPath: \InstalledApp.expirationDate, ascending: true)],
-                                             in: context)
+        // Cartouche: the apps Cartouche installed that were not renewed since,
+        // and Cartouche, added below, as for Refresh All Apps
+        // (fetchAppsForRefreshingAll).
+        var installedApps = InstalledApp.fetchCartoucheApps(in: context, refreshedBefore: date)
         
         if let altStoreApp = InstalledApp.fetchAltStore(in: context), altStoreApp.refreshedDate < date
         {
